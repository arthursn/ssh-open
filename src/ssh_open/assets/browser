#!/usr/bin/env bash
# Sent to remote by ssh_wrapper. Opens URLs on the host via the ssh-open listener.
# SSH_OPEN_SOCK is set per session by ssh-open and points to a Unix socket that
# is reverse-forwarded to that session's host listener; find-sock validates it.

URL="$1"

if [ -z "$URL" ]; then
    echo "Usage: browser <url>" >&2
    exit 1
fi

# Fall back to another live session if ours is gone (e.g. reattached tmux).
SSH_OPEN_SOCK=$("$HOME/.ssh-open/find-sock") || {
    echo "browser: no live ssh-open session found (connect with ssho first)" >&2
    exit 1
}

# The listener replies and closes the connection, so nc exits on its own.
printf '%s\n' "{\"url\": \"$URL\", \"version\": 1}" | nc -U "$SSH_OPEN_SOCK"
